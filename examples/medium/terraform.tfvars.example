# Copy this file to terraform.tfvars and fill in your values.

# Fully-qualified domain for n8n. The parent zone must be hosted in Route53.
n8n_domain = "n8n.example.com"

# Route53 hosted zone ID for the parent domain (e.g. example.com).
# aws route53 list-hosted-zones --query "HostedZones[?Name=='example.com.'].Id" --output text
route53_zone_id = "ZXXXXXXXXXXXXXXXXX"

# n8n Enterprise license activation key. Get one at https://n8n.io/pricing.
n8n_license_key = "your-license-key-here"

# AWS region. Change if deploying outside us-east-1.
# aws_region = "eu-west-1"

# EKS cluster name. Keep to 14 characters or fewer.
cluster_name = "n8n-medium"

# Extra AWS tags applied to every resource this example creates.
tags = {
  Environment = "production"
  Owner       = "your-team"
}

# Extra hostnames n8n should answer on, beyond n8n_domain. Each one is added to
# the module-issued certificate as a subject alternative name, gets its own
# Route 53 validation and alias records, and is routed by the Ingress. n8n_domain
# stays canonical: it is what n8n advertises as its webhook URL.
# n8n_additional_domains = ["hooks.n8n.example.com"]

# Where n8n stores execution data. Default "database" keeps it in PostgreSQL.
# "s3" offloads every new execution to the bucket the module already creates for
# binary data, which is the main lever for relieving write pressure on the
# database at this volume. It needs n8n >= 2.27 and an Enterprise license with
# the feat:executionDataS3 entitlement, and it does not backfill: existing
# executions stay readable where they were written. Read the execution data
# section of the root README first, including the durability trade-off (the
# bucket has no backups and no versioning) and the S3 lifecycle constraint.
# n8n_execution_data_storage_mode = "s3"
# n8n_image_tag                   = "2.27.4"

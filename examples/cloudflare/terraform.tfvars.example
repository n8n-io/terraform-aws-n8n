# Copy this file to terraform.tfvars and fill in your values.

# Fully-qualified domain for n8n. Must be a subdomain managed in your
# Cloudflare zone (e.g. n8n.example.com if your zone is example.com).
n8n_domain = "n8n.example.com"

# Cloudflare zone ID for the domain above. Find it on the Overview page
# of your zone in the Cloudflare dashboard (right-hand sidebar).
cloudflare_zone_id = "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4"

# Cloudflare API token with Zone:DNS:Edit permission.
# Create one at https://dash.cloudflare.com/profile/api-tokens.
# You can also export CLOUDFLARE_API_TOKEN instead of setting this.
cloudflare_api_token = "your-cloudflare-api-token-here"

# n8n license activation key. Get one at https://n8n.io/pricing. Enterprise
# (feat:multipleMainInstances) for the default multi-main topology; Business is
# enough with n8n_main_hpa_min_replicas = 1 (see below).
n8n_license_key = "your-license-key-here"

# AWS region. Change if you're deploying outside us-east-1.
# aws_region = "eu-west-1"

# EKS cluster name. Keep to 14 characters or fewer — ElastiCache cluster IDs
# derived from this name are capped at 20 chars, and '-redis' consumes 6.
# cluster_name = "n8n-cluster"

# Extra AWS tags applied to every resource this example creates.
# tags = {
#   Environment = "production"
#   Owner       = "platform-team"
# }

# Where n8n stores execution data. Default "database" keeps it in PostgreSQL.
# "s3" offloads every new execution to the bucket the module already creates for
# binary data. This example runs the module's default db.t3.small on 50 GB of gp2
# with a 150 IOPS baseline, the least room of any sizing this module ships, so
# reach for this before resizing the database. It needs n8n >= 2.27 and an
# Enterprise license with the feat:executionDataS3 entitlement, and it does not
# backfill: existing executions stay readable where they were written. Read the
# execution data section of the root README first, including the durability
# trade-off (the bucket has no backups and no versioning) and the S3 lifecycle
# constraint.
# n8n_execution_data_storage_mode = "s3"
# n8n_image_tag                   = "2.27.4"

# Minimum (and default) replica count for n8n main pods. Leave commented to
# use the module's default of 2 (multi-main, needs an Enterprise/Startup
# license carrying feat:multipleMainInstances). Set to 1 to run single-main
# in plain queue mode instead, which only needs a Business-tier license.
# n8n_main_hpa_min_replicas = 1

# Egress through a TLS-inspecting proxy. See docs/tls-proxy.md. Reaches the
# n8n containers only, not the task runner sidecars. Never embed credentials
# in a proxy URL: the values are stored in plaintext in Terraform state and
# the Helm release.
# n8n_extra_ca_pem = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
# EOT
# n8n_extra_env = [
#   { name = "HTTP_PROXY", value = "http://proxy.example.com:3128" },
#   { name = "HTTPS_PROXY", value = "http://proxy.example.com:3128" },
#   { name = "NO_PROXY", value = ".svc,.cluster.local,169.254.170.23" },
# ]

# Inbound only: a proxy or WAF in front of the ALB that adds its own
# X-Forwarded-For entry. Leave unset (the default 1) for egress-only setups.
# Turning on Cloudflare proxying (proxied = true in dns.tf) adds such a hop:
# set 2 and restrict the ALB to Cloudflare's published IP ranges.
# A caller that bypasses the declared proxy can forge X-Forwarded-For at any
# hop count of 1 or more, including an in-cluster caller reaching the n8n
# Services directly.
# Restrict the ALB to that proxy with the module's alb_inbound_cidrs or
# alb_inbound_prefix_list_ids input; this example does not pass either
# through, so add it in main.tf.
# n8n_proxy_hops = 2

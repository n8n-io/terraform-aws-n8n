# Copy this file to terraform.tfvars and fill in your values.

# Fully-qualified domain for n8n. The parent zone must be hosted in Route53.
n8n_domain = "n8n.example.com"

# Route53 hosted zone ID for the parent domain (e.g. example.com). The module
# issues and validates the ACM certificate here; this example's own dns.tf
# creates the alias A-record.
route53_zone_id = "Z0123456789ABCDEFGHIJ"

# n8n Enterprise license activation key. Get one at https://n8n.io/pricing.
n8n_license_key = "your-enterprise-license-key-here"

# Minimum (and default) replica count for n8n main pods. Leave commented to
# use the module's default of 2 (multi-main, needs an Enterprise/Startup
# license carrying feat:multipleMainInstances). Set to 1 to run single-main
# in plain queue mode instead, which only needs a Business-tier license.
# n8n_main_hpa_min_replicas = 1

# AWS region. Change if you're deploying outside us-east-1.
# aws_region = "eu-west-1"

# EKS cluster name. Keep to 14 characters or fewer.
# cluster_name = "n8n-cluster"

# Master password for the stand-in customer-managed RDS instance this example
# creates. Change this from the insecure demo default before leaving this
# stack up for anything but a throwaway test.
# customer_managed_db_password = "change-me-to-something-random-and-long"

# AUTH token for the stand-in customer-managed Redis this example creates.
# Change this from the insecure demo default before leaving this stack up for
# anything but a throwaway test. Must be 16-128 characters (ElastiCache's own
# constraint).
# customer_managed_redis_auth_token = "change-me-to-something-random-and-long"

# Extra AWS tags applied to every resource this example creates.
# tags = {
#   Environment = "production"
#   Owner       = "platform-team"
# }
